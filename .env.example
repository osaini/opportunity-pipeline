# Template for .env, which is gitignored and personal: never commit or share it.
# `python -m opportunity_app.setup init` copies this file to .env and fills in
# the generated secrets. To add a key without typing it into a chat, run
# `python -m opportunity_app.setup set-key NAME`.
# A real environment variable always wins over .env.

# --- Generated by setup: no signup needed --------------------------------------

# The owner token. The launcher (`python -m opportunity_app.launch open`) uses
# it to sign your browser in; you should never need to copy it by hand.
PIPELINE_WEB_TOKEN=
PIPELINE_EMPLOYER_TOKEN=
PIPELINE_ADMIN_TOKEN=
# Fernet key that encrypts stored OAuth tokens (Gmail drafts), and a separate
# HMAC secret for webhooks.
PIPELINE_CONNECTION_KEY=
PIPELINE_WEBHOOK_SECRET=

# --- Optional: more job sources ------------------------------------------------
# The public employer job boards need no keys. Each pair below adds a source.

# Federal jobs. Free key from https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# The email address you registered that key with. USAJOBS sends it as the
# User-Agent and rejects requests that do not match the registered address.
USAJOBS_CONTACT_EMAIL=

# Radius search around your city. Free at https://developer.adzuna.com/
# Adzuna issues these two together and rejects a request missing either half.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional: AI features -------------------------------------------------------

# Subscription-backed CLI providers (no API key): install Claude Code (`claude`)
# or Codex CLI (`codex`) and log in with the account you already pay for. The
# agent runs them headless per turn; your approval gates stay authoritative.
# PIPELINE_CLAUDE_BIN=
# PIPELINE_CODEX_BIN=
PIPELINE_AGENT_CLI_TIMEOUT=180

# Pay-per-use API providers for the career agent; configure either, both, or neither.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_CALLS_PER_TURN=8
AGENT_MAX_OUTPUT_TOKENS=1200

# Outreach: which provider runs the deep search (claude-code or codex-cli; setup
# picks whichever CLI you have) and which drafts emails (blank = agent default,
# or `legacy` for the no-AI template).
PIPELINE_OUTREACH_DISCOVERY_PROVIDER=
PIPELINE_OUTREACH_PROVIDER=

# Optional TypeSafe Jev reviews (waitlisted; everything else works without it).
# Reviews never change the deterministic fit score and run only on request.
TYPESAFE_API_KEY=
# Pinned so reviewed thresholds do not drift silently; upgrade deliberately.
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_TIMEOUT=20

# --- Optional: email and outreach ------------------------------------------------

# Gmail drafts need your own Google Cloud OAuth client (README: Gmail drafts).
# Without them, approved emails open as mailto links instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# `gmail` opens approved drafts in PIPELINE_OUTREACH_ACCOUNT; default `mailto`.
PIPELINE_OUTREACH_COMPOSE=
PIPELINE_OUTREACH_ACCOUNT=
# File attached to outreach Gmail drafts, relative to the project root or absolute.
PIPELINE_OUTREACH_ATTACHMENT=
# Your name and email, sent to SEC EDGAR as the User-Agent it requires of
# automated clients. Enables Form D lookups for outreach companies.
PIPELINE_SEC_USER_AGENT=

# Email notifications (password recovery codes). Off unless both are set.
PIPELINE_NOTIFICATIONS_LIVE=
PIPELINE_SMTP_HOST=
PIPELINE_SMTP_PORT=587
PIPELINE_SMTP_USERNAME=
PIPELINE_SMTP_PASSWORD=
PIPELINE_SMTP_TLS=1
PIPELINE_NOTIFY_SENDER=

# --- Optional: advanced ------------------------------------------------------------

# IANA time zone for due dates and reminders, e.g. America/Chicago. Blank uses
# the one set in the app, then this computer's.
PIPELINE_TIMEZONE=
# Separate Fernet key used only by encrypted backups.
PIPELINE_BACKUP_KEY=
# Worker cadences in hours, per stage (fetch, enrich, score, liveness, report).
# Unset means off; the daily run covers these.
# PIPELINE_SCHEDULE_FETCH_HOURS=
# Hosted deployments only (leave blank for a local copy).
DATABASE_URL=
PIPELINE_PUBLIC_ORIGIN=
PIPELINE_ENV=development
