{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "[Gg]mail",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/mailbox-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/mailbox-guard.mjs", "--forget-session"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
