__pycache__/
*.pyc
.env
.venv*/
# Everything the pipeline writes is personal: databases and their backups,
# logs, discovered jobs, resumes, captures, outreach contacts and drafts, and
# the resume attached to Gmail drafts. Ignore the whole directory so a new kind
# of file is private by default; only the empty manual-jobs template is shared.
data/*
!data/manual_jobs.csv
output/
# Personal: contact details, coursework, project history. config/resume.example.json
# is the tracked template.
config/resume.json
# Personal: one student's scoring profile and source overlay. The tracked
# templates are config/profile.example.json and config/sources.local.example.json.
config/profile.json
config/*.local.json
config/*.local.json.tmp
# Personal notes and plans that should never ship to other students, including
# private/blocked-terms.txt, read by scripts/check_personal_data.py.
private/
.DS_Store
.claude/settings.local.json

# Browser and contract testing
.venv-ui/
.venv-fuzz/
node_modules/
.schemathesis/
