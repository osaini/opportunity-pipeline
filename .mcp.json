{
  "mcpServers": {
    "codex": {
      "command": "codex",
      "args": ["mcp-server"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--browser", "chromium",
        "--viewport-size", "1280,900",
        "--isolated",
        "--allowed-origins", "http://127.0.0.1:8799;http://localhost:8799",
        "--save-trace",
        "--output-dir", "./data/playwright-mcp"
      ]
    }
  }
}
